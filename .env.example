# Token Instagram (Instagram API with Instagram Login) – lấy trong App Dashboard > Instagram > API setup
IG_ACCESS_TOKEN=

# App Secret của app Instagram – dùng để xác thực chữ ký webhook
IG_APP_SECRET=

# Chuỗi bất kỳ do bạn tự đặt, nhập giống hệt khi đăng ký webhook trên Meta
VERIFY_TOKEN=doi-chuoi-nay-cho-bi-mat

# Phiên bản Graph API
GRAPH_VERSION=v23.0

PORT=3000

# Khóa API Claude (console.anthropic.com > API Keys). Có khóa = bot trả lời bằng AI; để trống = trả lời theo rules.json
ANTHROPIC_API_KEY=
# Giới hạn chi phí: tổng câu AI mỗi ngày và mỗi khách mỗi ngày
AI_DAILY_LIMIT=500
AI_PER_USER_DAILY=40

# AI dự phòng: khi Claude lỗi / bị giới hạn thì thử OpenAI, rồi Gemini, cuối cùng mới dùng rules.json. Để trống = bỏ qua AI đó
# OpenAI: platform.openai.com > API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Gemini: aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- WhatsApp ----
# meta = API trực tiếp của Meta (số chỉ dùng cho API); 360dialog = qua BSP 360dialog (dùng chung số với app WhatsApp Business)
WA_PROVIDER=360dialog
# Meta: access token (System User) | 360dialog: D360-API-KEY
WA_TOKEN=
# Chỉ cần khi WA_PROVIDER=meta
WA_PHONE_NUMBER_ID=
# Chuỗi bí mật tự đặt; webhook WhatsApp là https://<bot>/whatsapp?key=<WA_WEBHOOK_KEY>, danh sách khách: /leads?key=<WA_WEBHOOK_KEY>
WA_WEBHOOK_KEY=
# Email báo khách cần báo giá (Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PASS là "Mật khẩu ứng dụng" 16 ký tự)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
# Telegram báo khách hỏi giá (Instagram + WhatsApp). Tạo bot với @BotFather để lấy token;
# chat với bot 1 câu rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates để lấy chat id. Nhiều người nhận: cách nhau dấu phẩy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trợ lý soạn trả lời cho sale: mở https://<bot>/assistant, nhập mật khẩu này một lần. Để trống = tắt
ASSISTANT_KEY=
# Số lượt soạn tối đa mỗi ngày (giới hạn chi phí)
ASSISTANT_DAILY_LIMIT=300

# true = chỉ in ra log, không gửi tin thật (dùng khi test)
DRY_RUN=false
